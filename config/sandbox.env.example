# COPY THIS FILE TO THE REPOSITORY ROOT AS .env FOR A LOCAL TEST ONLY.
# Never commit .env. Never point these settings at your existing laboratory data.
PORT=3007
HOST=127.0.0.1
NODE_ENV=production

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tlab_local_test
MYSQL_USER=tlab_sandbox
MYSQL_PASSWORD=
MYSQL_CONNECTION_TIMEOUT=8000
MYSQL_AUTO_SYNC=false

TLAB_ADMIN_PASSWORD=
TLAB_ENABLE_LEGACY_API=false
TLAB_ENABLE_UNSAFE_BULK_IMPORT=false
TLAB_ENABLE_SNAPSHOT_PULL=false
TLAB_ALLOW_SCHEMA_BOOTSTRAP=false
TLAB_ALLOW_DB_CREATION=false
# Only for disposable branch-scope patient pilot; blocks unscoped v2 clinical/financial operations.
TLAB_MULTIBRANCH_MODE=false
# Set TLAB_SANDBOX_INIT only temporarily via scripts/windows-local-pilot.ps1
