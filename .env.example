# ============================================================================
# T-Lab (Medical Lab Management System) - Environment Variables Template
# ============================================================================
# Copy this file to .env for local development. Never commit real secrets!

# Gemini API (إذا كان مطلوباً / Optional external AI integration)
GEMINI_API_KEY=your_gemini_api_key_here

# Database (إذا كان هناك backend لاحقاً / Optional backend database connection)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Security
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# App Settings
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
